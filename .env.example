# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.

NODE_ENV=development
PORT=4000

# "memory" runs with no database (local demo + tests). "supabase" uses the vars below.
DB_DRIVER=memory

# Use a NEW Supabase project for Arrivo. Do not point this at another app's production database.
SUPABASE_URL=
# Server-side only. Bypasses row level security. Never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Comma separated browser origins allowed to call the API (mobile apps do not need this).
CORS_ORIGINS=

# Marks journeys overdue once the grace period passes. Off by default.
ENABLE_OVERDUE_JOB=false

# DEV ONLY: lets you mark a contact as accepted to test journeys. Rejected in production.
ENABLE_DEV_ROUTES=true

# Base of the public watch link shown to contacts.
WATCH_BASE_URL=https://arrivo.app/w

# Email (Resend). Leave empty to skip sending. Domain must be verified in Resend.
RESEND_API_KEY=re_xxxxxx
MAIL_FROM=Arrivo <invites@tryarrivo.com>

# Place search (Google Places API New + Geocoding API), called from the server only.
# Use a SEPARATE key from the Android Maps key: restrict it to those two APIs, no Android-app restriction.
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# Profile photos (Cloudinary). The API secret stays here; the app only gets a signed, one-user upload permit.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Routes API (distance, time, route line). Defaults to GOOGLE_PLACES_API_KEY, so one server key can do both.
# Enable "Routes API" for this key in Google Cloud.
GOOGLE_ROUTES_API_KEY=
